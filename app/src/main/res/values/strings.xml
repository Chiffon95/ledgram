    <string name="privacy_policy_local_title">Information stored on your device</string>
    <string name="privacy_policy_local_body">LEDgram stores Editor preferences locally on this device. These preferences include message text; text and background colors; Bold, Italic, and Underline styles; Render Style; Motion and Effect selections; and Motion Speed and Effect Speed. LEDgram also stores local Display-exit counters and interstitial timestamps used for advertising frequency control.</string>
    <string name="privacy_policy_content_title">Your content and app services</string>
    <string name="privacy_policy_content_body">LEDgram does not manually upload your LED message text to Gowl Labs. LEDgram currently has no user accounts and no backend or server for user content. LEDgram does not currently use Firebase Analytics or Crashlytics.</string>
    <string name="privacy_policy_ads_title">Advertising and consent</string>
    <string name="privacy_policy_ads_body">LEDgram includes Google Mobile Ads for advertising and Google UMP for consent and privacy choices where applicable. Google advertising components may process information according to Google’s own policies. Display mode itself contains no ads.</string>
    <string name="privacy_policy_controls_title">Your controls</string>
    <string name="privacy_policy_controls_body">You can reset Editor settings locally from Settings. Editor reset does not reset Google UMP consent or privacy choices, advertising state, or monetization frequency counters and timestamps. Those settings have separate purposes and controls.</string>
    <string name="privacy_policy_changes_title">Policy changes</string>
    <string name="privacy_policy_changes_body">Future versions may update this policy if LEDgram’s behavior changes. The effective date above identifies this version of the policy.</string>
    <string name="open_source_licenses_intro">This list covers the major open-source libraries used by the current build.</string>
    <string name="third_party_sdks_title">Third-party SDKs</string>
    <string name="third_party_sdks_body">These Google SDKs are used by LEDgram for advertising and consent management. They are governed by Google’s applicable terms and policies and are not listed here as open-source libraries.</string>
